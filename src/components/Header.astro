---
import { SITE, NAV_ITEMS } from '../config';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(target + '/');
};
---

<header class="site-header" data-site-header>
  <div class="wrap bar">
    <a class="site-title" href="/">{SITE.title}</a>
    <nav class="site-nav" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.text}
        </a>
      ))}
      <button class="icon-btn" type="button" aria-label="搜索" title="搜索（⌘K）" data-open-palette>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深浅主题">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // 快捷键提示按平台显示（⌘K / Ctrl K）
  const searchBtn = document.querySelector<HTMLButtonElement>('[data-open-palette]');
  if (searchBtn) {
    const isApple = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
    searchBtn.title = isApple ? '搜索（⌘K）' : '搜索（Ctrl K）';
  }

  // ⌘K / Ctrl+K 与搜索图标：唤出命令面板（任意页面可用）
  const openPalette = () => document.dispatchEvent(new CustomEvent('open-palette'));
  searchBtn?.addEventListener('click', openPalette);
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openPalette();
    }
  });

  // 滚动后顶栏浮现发丝分割线
  const header = document.querySelector('[data-site-header]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // 主题切换：View Transitions 圆形揭示（尊重系统减弱动效设置）
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', (e) => {
    const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      document
        .querySelectorAll('meta[name="theme-color"]')
        .forEach((m) => m.remove());
      const meta = document.createElement('meta');
      meta.name = 'theme-color';
      meta.content = next === 'dark' ? '#000000' : '#fafafa';
      document.head.appendChild(meta);
    };
    // 重组件（Mermaid/giscus）的重绘推迟到切换动画结束后，避免动画期间主线程阻塞
    const notify = () => document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const startTransition = (document as unknown as {
      startViewTransition?: (cb: () => void) => { finished: Promise<void> };
    }).startViewTransition;
    if (!startTransition || reduce) {
      apply();
      notify();
      return;
    }
    const toggle = document.querySelector('[data-theme-toggle]');
    let { clientX: x, clientY: y } = e instanceof MouseEvent ? e : {};
    // 键盘激活等合成 click 的 clientX/Y 为 0，会从左上角扩散；锚点回退到按钮中心
    const rect = toggle?.getBoundingClientRect();
    if (!rect || x == null || y == null || x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) {
      x = rect ? rect.left + rect.width / 2 : window.innerWidth - 32;
      y = rect ? rect.top + rect.height / 2 : 24;
    }
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    root.style.setProperty('--x', `${x}px`);
    root.style.setProperty('--y', `${y}px`);
    root.style.setProperty('--r', `${radius}px`);
    root.classList.add('theme-anim');
    startTransition
      .call(document, apply)
      .finished.finally(() => {
        root.classList.remove('theme-anim');
        notify();
      });
  });
</script>
