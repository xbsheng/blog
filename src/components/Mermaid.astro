---
/**
 * Mermaid 客户端渲染：仅当页面存在 .mermaid 时才动态加载 mermaid 包，
 * 并跟随站点主题重绘（监听 themechange 事件）。
 */
---

<script>
  type MM = {
    initialize: (cfg: Record<string, unknown>) => void;
    render: (id: string, src: string) => Promise<{ svg: string }>;
  };

  // 主题变量镜像站点令牌（值为构建期常量，与 --surface 系同步维护，
  // 替代 mermaid 库默认皮肤以保证深浅两主题下都与近单色世界一致）
  const PALETTES = {
    light: {
      primaryColor: '#ebebeb',
      primaryBorderColor: '#d4d4d4',
      primaryTextColor: '#171717',
      secondaryColor: '#ffffff',
      tertiaryColor: '#fafafa',
      lineColor: '#d4d4d4',
      textColor: '#171717',
      titleColor: '#171717',
      edgeLabelBackground: '#fafafa',
      noteBkgColor: '#fafafa',
      noteTextColor: '#666666',
      noteBorderColor: '#d4d4d4',
      clusterBkg: '#fafafa',
      clusterBorder: '#eaeaea',
    },
    dark: {
      primaryColor: '#1f1f1f',
      primaryBorderColor: '#444444',
      primaryTextColor: '#ededed',
      secondaryColor: '#0a0a0a',
      tertiaryColor: '#000000',
      lineColor: '#444444',
      textColor: '#ededed',
      titleColor: '#ededed',
      edgeLabelBackground: '#0a0a0a',
      noteBkgColor: '#0a0a0a',
      noteTextColor: '#a1a1a1',
      noteBorderColor: '#444444',
      clusterBkg: '#111111',
      clusterBorder: '#333333',
    },
  };
  type ThemeName = keyof typeof PALETTES;

  let mermaid: MM | null = null;
  let loadedTheme: ThemeName | '';
  // 按主题缓存渲染好的 SVG：主题来回切换时直接换图，零重绘
  const svgCache = new Map<string, string>();

  const simpleHash = (s: string) => {
    let h = 0;
    for (let i = 0; i < s.length; i++) h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
    return Math.abs(h).toString(36);
  };

  async function renderAll(theme: ThemeName) {
    const nodes = document.querySelectorAll<HTMLElement>('.mermaid');
    if (nodes.length === 0) return;
    if (document.documentElement.classList.contains('js-graph') === false) {
      document.documentElement.classList.add('js-graph');
    }
    if (!mermaid || loadedTheme !== theme) {
      mermaid = (await import('mermaid')).default as unknown as MM;
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        themeVariables: {
          fontFamily:
            "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
          fontSize: '15px',
          ...PALETTES[theme],
        },
      });
      loadedTheme = theme;
    }
    for (const el of nodes) {
      const src = el.dataset.source ?? el.textContent ?? '';
      el.dataset.source = src;
      if (el.dataset.renderedTheme === theme && el.dataset.rendered === 'true') continue;
      const cacheKey = `${theme}::${simpleHash(src)}`;
      try {
        let svg = svgCache.get(cacheKey);
        if (!svg) {
          const res = await mermaid.render('mmd-' + Math.random().toString(36).slice(2), src);
          svg = res.svg;
          svgCache.set(cacheKey, svg);
        }
        el.innerHTML = svg;
        el.dataset.rendered = 'true';
      } catch (err) {
        console.error('[mermaid] 渲染失败', err);
        el.dataset.rendered = 'failed';
      }
      el.dataset.renderedTheme = theme;
    }
  }

  renderAll(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  document.addEventListener('themechange', (e) => {
    renderAll((e as CustomEvent<string>).detail === 'dark' ? 'dark' : 'light');
  });
</script>
