---
/**
 * 全局命令面板：任意页面 ⌘K / 点击搜索图标唤出。
 * 空查询显示快捷入口；输入时用 Pagefind JS API 即时检索文章。
 * 搜索页 /search/ 保留为完整结果页，面板内提供入口。
 */
---

<div class="palette-root" data-palette hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette" role="dialog" aria-modal="true" aria-label="搜索与快捷导航" tabindex="-1" data-palette-panel>
    <div class="palette-inputrow">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="text"
        placeholder="搜索文章，或输入关键词…"
        aria-label="搜索文章"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <button class="palette-esc" type="button" aria-label="关闭面板" data-palette-close>esc</button>
    </div>
    <div class="palette-body" data-palette-body></div>
  </div>
</div>

<script>
  import { deepQueryInput } from '../lib/deep-input';

  const root = document.querySelector<HTMLElement>('[data-palette]');
  const panel = root?.querySelector<HTMLElement>('[data-palette-panel]');
  const input = root?.querySelector<HTMLInputElement>('[data-palette-input]');
  const body = root?.querySelector<HTMLElement>('[data-palette-body]');
  if (root && panel && input && body) {
    const QUICK_LINKS = [
      { title: '首页', url: '/', hint: '最新文章与订阅入口' },
      { title: '归档', url: '/archive/', hint: '全部文章按年整理' },
      { title: '标签', url: '/tags/', hint: '按主题浏览' },
      { title: '关于', url: '/about/', hint: '博主与这个博客' },
      { title: '搜索页', url: '/search/', hint: '完整搜索结果页' },
    ];

    type PF = {
      options: (o: Record<string, unknown>) => Promise<void>;
      search: (q: string) => Promise<{ results: Array<{ data: () => Promise<{ url: string; meta: Record<string, string>; excerpt: string }> }> }>;
    };
    let pagefind: PF | null = null;
    let pagefindFailed = false;
    let activeIndex = 0;
    let currentItems: Array<{ title: string; url: string; excerpt?: string }> = [];
    let lastOpener: HTMLElement | null = null;
    let debounceTimer = 0;

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    async function ensurePagefind() {
      if (pagefind || pagefindFailed) return;
      try {
        // /pagefind/pagefind.js 由 Pagefind 构建后生成，必须留给浏览器运行时加载
        pagefind = (await import(/* @vite-ignore */ '/pagefind/pagefind.js')) as unknown as PF;
        await pagefind.options({ baseUrl: '/' });
      } catch {
        // 开发环境没有搜索索引（pnpm build 之后才会生成）
        pagefindFailed = true;
      }
    }

    function render(items: Array<{ title: string; url: string; excerpt?: string }>, query: string) {
      currentItems = items;
      activeIndex = items.length ? 0 : -1;
      if (items.length === 0) {
        body.innerHTML = query
          ? `<p class="palette-empty">没有找到与「${esc(query)}」相关的内容。</p>`
          : `<ul class="palette-list">${QUICK_LINKS.map(
              (l) =>
                `<li><a href="${l.url}" data-palette-item><span class="palette-item-title">${l.title}</span><span class="palette-item-hint">${l.hint}</span></a></li>`
            ).join('')}</ul>`;
        return;
      }
      body.innerHTML = `<ul class="palette-list">${items
        .map(
          (it, i) =>
            `<li><a href="${it.url}" data-palette-item class="${i === activeIndex ? 'active' : ''}"><span class="palette-item-title">${esc(it.title)}</span>${
              it.excerpt ? `<span class="palette-item-excerpt">${it.excerpt}</span>` : ''
            }</a></li>`
        )
        .join('')}</ul>`;
      body.querySelectorAll('a[data-palette-item]').forEach((a) => {
        a.addEventListener('click', () => close());
        a.addEventListener('mouseenter', () => setActive(items.indexOf(items.find((it) => it.url === a.getAttribute('href')) ?? items[0])));
      });
      setActive(activeIndex);
    }

    function setActive(i: number) {
      if (i < 0 || i >= currentItems.length) return;
      activeIndex = i;
      body.querySelectorAll('a[data-palette-item]').forEach((a, idx) => a.classList.toggle('active', idx === i));
      body.querySelector('a.active')?.scrollIntoView({ block: 'nearest' });
    }

    async function onInput() {
      const q = input.value.trim();
      if (!q) {
        render([], '');
        return;
      }
      await ensurePagefind();
      if (!pagefind) {
        body.innerHTML = '<p class="palette-empty">搜索索引需要构建后可用：先运行 pnpm build，再访问预览。</p>';
        return;
      }
      const res = await pagefind.search(q);
      const data = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
      render(
        data.map((d) => ({ title: d.meta?.title ?? d.url, url: d.url, excerpt: d.excerpt })),
        q
      );
    }

    function setOpen(open: boolean) {
      root.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        input.value = '';
        render([], '');
        panel.focus({ preventScroll: true });
        ensurePagefind();
      } else {
        lastOpener?.focus({ preventScroll: true });
      }
    }

    document.addEventListener('open-palette', () => {
      lastOpener = document.activeElement as HTMLElement;
      setOpen(true);
      input.focus();
    });
    root.querySelectorAll('[data-palette-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key === 'Tab') {
        const items = [input, ...Array.from(body.querySelectorAll('a[href]'))] as HTMLElement[];
        const escBtn = root.querySelector<HTMLElement>('.palette-esc');
        if (escBtn) items.push(escBtn);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || active === panel)) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      if (document.activeElement === input) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(Math.min(activeIndex + 1, currentItems.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(Math.max(activeIndex - 1, 0));
        } else if (e.key === 'Enter' && activeIndex >= 0 && currentItems[activeIndex]) {
          location.href = currentItems[activeIndex].url;
        }
      }
    });
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(onInput, 140);
    });

    // 页头（⌘K / 搜索图标）通过该事件唤出面板
    document.addEventListener('open-palette', () => {
      lastOpener = document.activeElement as HTMLElement;
      setOpen(true);
      input.focus();
    });
  }
</script>
