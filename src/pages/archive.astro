---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { published, sortByDate, groupByYear } from '../utils';

const posts = sortByDate(published(await getCollection('posts')));
const groups = groupByYear(posts);
---

<Base title="归档">
  <header class="page-header">
    <h1>归档</h1>
  </header>

  <div class="archive-timeline">
    {
      groups.map(([year, list]) => (
        <section class="timeline-year" aria-labelledby={`year-${year}`}>
          <h2 class="year-label" id={`year-${year}`}>
            {year}
            <span>{list.length} 篇</span>
          </h2>
          <ul class="post-list timeline-posts">
            {list.map((post) => (
              <PostRow post={post} withDesc={false} compact />
            ))}
          </ul>
        </section>
      ))
    }
    <p class="timeline-end">时间轴在这里暂告一段落~</p>
  </div>
</Base>
