---
import '../styles/global.css';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../config';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description = SITE.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131316" />
    <script is:inline>
      // 首帧前同步主题，避免闪烁
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline>
      // 百度统计：异步加载，不阻塞页面渲染
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?2cde7fb3fb56f53f18454b488082224e';
        var firstScript = document.getElementsByTagName('script')[0];
        firstScript.parentNode?.insertBefore(hm, firstScript);
      })();
    </script>
  </head>
  <body>
    <!--
      DESIGN CONTRACT (direction: canon / craft bar: antfu.me / seed key d001ca92)
      THESIS: 经典博客形态做到位：单栏阅读流、克制用色，让代码、图表、公式无声地成为主角，拒绝装饰性杂音。
      OWN-WORLD: 纸白/深灰双底，近单色加唯一紫罗兰强调色；系统字栈加 JetBrains Mono；1px 边框与悬停底色构成层次，无阴影堆叠。
      STORY: 访客十秒内知道作者是谁、写什么、最新有什么；长文阅读舒适，代码可复制，图表公式清晰，可搜索、可订阅。
      FIRST VIEWPORT: 顶栏（站名/导航/主题切换）之下是问候语、RSS 与 GitHub 入口、「最近文章」列表行（日期·标题·摘要·标签）。
      FORM: canon —— 用户在决策页主动选择类目标准（standing exit，非掷骰分配）。
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>
    <Footer />
    <SearchPalette />
    <Analytics />
    <SpeedInsights />
    <script>
      import { fileIconSvg } from '../lib/file-icons';

      // Expressive Code 复制按钮补充可访问名称（EC 默认只有 title 属性；
      // 按钮位于 figure.expressive-code > … > .copy 内）
      document
        .querySelectorAll<HTMLButtonElement>('.expressive-code .copy button')
        .forEach((b) => {
          if (!b.getAttribute('aria-label')) {
            b.setAttribute('aria-label', b.getAttribute('title') ?? '复制代码');
          }
        });

      // 未命名代码块的语言标签使用常见缩写，便于在右上角快速识别。
      const languageLabels: Record<string, string> = {
        typescript: 'ts',
        javascript: 'js',
        python: 'py',
        shell: 'sh',
        shellscript: 'sh',
        bash: 'sh',
        markdown: 'md',
        yaml: 'yml',
      };
      document
        .querySelectorAll<HTMLElement>('.expressive-code pre[data-language]')
        .forEach((pre) => {
          const language = pre.dataset.language?.toLowerCase();
          if (language) pre.dataset.languageLabel = languageLabels[language] ?? language;
        });

      // 带文件名的代码块：在标题前插入 vscode-icons 风格的文件类型图标
      document
        .querySelectorAll<HTMLElement>('.expressive-code figcaption .title')
        .forEach((span) => {
          if (span.dataset.iconDone) return;
          const name = span.textContent?.trim() ?? '';
          if (!name || !name.includes('.')) return;
          span.dataset.iconDone = '1';
          span.insertAdjacentHTML('afterbegin', fileIconSvg(name));
        });
    </script>
  </body>
</html>
